# AQUA — Firebase (Cloud Firestore + Auth), chạy trên gói Spark (miễn phí)
# Sao chép file này thành `.env.local` và điền giá trị từ Firebase Console.
# Project Settings → General → Your apps → Web app config
#
# Project KHÔNG dùng Firebase Storage (ảnh đại diện là URL tự dán, xem
# `pages/ProfilePage.jsx`) nên không cần VITE_FIREBASE_STORAGE_BUCKET.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Khi chưa điền, app tự fallback localStorage (Phase 3).
# Khi đã điền, Tasks/Projects đọc/ghi Firestore — KHÔNG ghi đè từ localStorage.

# Server-only Firebase Admin credentials for Vercel API routes.
# Never prefix these with VITE_ or expose them to the browser.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Server-side Gmail SMTP credentials for Vercel API routes.
# Never expose these values to the browser.
# SMTP_USER is the Gmail account used to send AQUA notification emails.
# SMTP_PASS is a Google App Password, NOT the normal Gmail password.
SMTP_USER=
SMTP_PASS=
